# Copy this file to .env and fill in your values, then: npm start

# Your Aero token from the Developer Portal (shown once on create/rotate).
AERO_TOKEN=

# Ballastra origin (gateway + REST). Production default:
BALLASTRA_URL=https://api.ballastra.app

# Where Velixar keeps its SQLite database (per-Nexus config, XP, tickets).
# Defaults to ./velixar.db if unset.
VELIXAR_DB=velixar.db

# NOTE: Ticket panel, welcome space, staff role and self-assign roles are NOT
# set here anymore. Velixar serves many Nexuses, so each Nexus owner configures
# it from inside their own Nexus with the setup commands:
#   /ticket-setup   /ticket-staff   /welcome-setup   /roles-add   /config
